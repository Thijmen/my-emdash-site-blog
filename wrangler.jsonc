{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site-blog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"secrets": {
		"required": ["CF_ACCESS_AUDIENCE"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site",
			"database_id": "8c3b5c36-3f4a-4e54-946b-9811ec632633"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media"
		}
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	// Bindings for Worker Previews (`wrangler preview`, run by Workers Builds on
	// non-production branches). NOT inherited from the top level — every binding
	// the worker needs must be redeclared here with the same names (DB, MEDIA,
	// LOADER), pointing at preview resources. The @astrojs/cloudflare adapter
	// carries this block into its generated deploy config and adds SESSION/IMAGES.
	"previews": {
		"observability": {
			"enabled": true,
			"logs": {
				"enabled": true,
				"invocation_logs": true
			}
		},
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "my-emdash-site-preview",
				"database_id": "430ad2a4-aa30-41cb-bda9-d0748f3f1008"
			}
		],
		"r2_buckets": [
			{
				"binding": "MEDIA",
				"bucket_name": "my-emdash-media-preview"
			}
		],
		"worker_loaders": [
			{
				"binding": "LOADER"
			}
		]
	},
	// Fallback preview environment while the account lacks Worker Previews
	// (private beta) access. Workers Builds non-production branches build with
	// `CLOUDFLARE_ENV=preview npm run build` — the @astrojs/cloudflare adapter
	// resolves this environment into its generated deploy config — and then
	// deploy with a plain `npx wrangler deploy`, producing a single shared
	// preview worker with the preview D1/R2. Bindings are not inherited from
	// the top level, so everything is redeclared.
	"env": {
		"preview": {
			"name": "my-emdash-site-blog-preview",
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"invocation_logs": true
				}
			},
			"secrets": {
				"required": ["CF_ACCESS_AUDIENCE"]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "my-emdash-site-preview",
					"database_id": "430ad2a4-aa30-41cb-bda9-d0748f3f1008"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "my-emdash-media-preview"
				}
			],
			"worker_loaders": [
				{
					"binding": "LOADER"
				}
			]
		}
	}
}
